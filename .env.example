# Copie ce fichier en ".env" puis colle ta clé API Claude (console.anthropic.com).
# Ne mets jamais le fichier .env sur GitHub : il est déjà ignoré par .gitignore.
ANTHROPIC_API_KEY=

# Optionnel : modèle utilisé par l'assistant (par défaut claude-haiku-4-5-20251001, rapide et économique).
# ANTHROPIC_MODEL=claude-sonnet-5-5
